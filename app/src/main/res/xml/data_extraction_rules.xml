<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Do not back up sensitive local encrypted credentials or chat history to external cloud -->
        <exclude domain="sharedpref" path="secret_shared_prefs.xml" />
        <exclude domain="database" path="mohammad_patrick.db" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="mohammad_patrick.db" />
    </device-transfer>
</data-extraction-rules>
